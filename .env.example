# Only HisabGuard reads these variables. Never put provider keys in the browser.
# No key: labelled deterministic review demonstration, NOT a live AI agent.
HISABGUARD_LLM_BASE_URL=https://api.openai.com/v1
HISABGUARD_LLM_API_KEY=
HISABGUARD_LLM_MODEL=gpt-4o-mini
HISABGUARD_VISION_MODEL=gpt-4o-mini
# Optional OpenRouter-only setting for optional-reasoning models: default or off.
# Ordinary OpenAI-compatible endpoints do not receive this extension.
HISABGUARD_REASONING_MODE=default

# Optional Groq/OpenAI-compatible Whisper transcription. Use a model that
# supports Bangla. No STT key: retain original audio for manual review.
HISABGUARD_STT_BASE_URL=https://api.groq.com/openai/v1
HISABGUARD_STT_API_KEY=
HISABGUARD_STT_MODEL=whisper-large-v3-turbo

# Required for Docker/non-loopback/public access. Choose a long random secret.
# Empty is allowed only for direct local loopback development.
HISABGUARD_ACCESS_TOKEN=
HISABGUARD_DEV_ORIGIN=http://127.0.0.1:5181
# Default: runtime/ in this repository. Docker sets /var/lib/hisabguard.
HISABGUARD_DATA_DIR=
# 1 seeds three explicitly synthetic trips only when the database is empty.
# 0 starts an empty operator register in a fresh data directory.
HISABGUARD_SEED_DEMO=1
